CompileFlags:
  Add:
    - "-isysroot"
    - "/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk"
    - "-target"
    - "arm64-apple-ios15.0-simulator"
    - "-fobjc-arc"
    - "-fmodules"
    - "-fcxx-modules"
    - "-I/Users/admin/Desktop/Projects/skladka-app/apps/mobile/ios/Pods/Headers/Public"
    - "-I/Users/admin/Desktop/Projects/skladka-app/apps/mobile/ios/Pods/Headers/Public/Yoga"
    - "-I/Users/admin/Desktop/Projects/skladka-app/apps/mobile/ios/Pods/Headers/Public/React-Core"
    - "-I/Users/admin/Desktop/Projects/skladka-app/apps/mobile/ios/Pods/Headers/Public/React-RCTAppDelegate"
    - "-I/Users/admin/Desktop/Projects/skladka-app/apps/mobile/ios/Pods/Headers/Public/ReactCommon"
    - "-I/Users/admin/Desktop/Projects/skladka-app/apps/mobile/ios/Pods/Headers/Public/RCT-Folly"
    - "-I/Users/admin/Desktop/Projects/skladka-app/apps/mobile/ios/Pods/Headers/Public/DoubleConversion"
    - "-I/Users/admin/Desktop/Projects/skladka-app/apps/mobile/ios/Pods/Headers/Public/glog"
    - "-I/Users/admin/Desktop/Projects/skladka-app/apps/mobile/ios/Pods/Headers/Public/fmt"
