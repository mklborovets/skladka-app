{
  "name": "skladka",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --prefix apps/mobile start",
    "android": "npm --prefix apps/mobile run android",
    "ios": "npm --prefix apps/mobile run ios",
    "emulators": "npm --prefix packages/firebase-backend run emulators",
    "seed": "npm --prefix packages/firebase-backend run seed",
    "test": "npm --prefix packages/firebase-backend test",
    "typecheck": "npm --prefix apps/mobile run typecheck && npm --prefix packages/firebase-backend run typecheck"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.9.6"
    }
  }
}
